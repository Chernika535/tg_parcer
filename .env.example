DATABASE_URL=            # выдаёт Onreza (managed Postgres)
TELEGRAM_BOT_TOKEN=      # токен бота от @BotFather
CRON_SECRET=             # длинная случайная строка, защищает /api/cron
APP_USER_ID=local        # единственный пользователь однопользовательской версии
APP_BASE_URL=            # публичный URL приложения на Onreza

# KV-доступ идёт через SDK Onreza (@onreza/runtime/kv), отдельной переменной не требует.
# ONREZA: подтвердить по docs, что KV не требует переменной окружения.
